{
    "name": "blinkpay/blink-debit-api-client-php",
    "description": "Framework-agnostic PHP client for the Blink Debit API (Blink PayNow and Blink AutoPay): consents, quick payments, payments, refunds, fixed recurring payments, transactions and webhooks, with PSR-18/PSR-16/PSR-6 adapters and Laravel, Symfony and CakePHP glue",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "blinkpay",
        "blink-debit",
        "open-banking",
        "payments",
        "new-zealand",
        "laravel",
        "symfony",
        "cakephp",
        "psr-18"
    ],
    "authors": [
        {
            "name": "BlinkPay",
            "homepage": "https://www.blinkpay.co.nz"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0",
        "psr/cache": "^1.0",
        "psr/simple-cache": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "psr/http-client": "To send requests through a PSR-18 HTTP client via Psr18Transport (with psr/http-factory and psr/http-message)",
        "psr/simple-cache": "To persist access tokens in a PSR-16 cache via Psr16TokenCache (Laravel, CakePHP)",
        "psr/cache": "To persist access tokens in a PSR-6 cache pool via Psr6TokenCache (Symfony)",
        "laravel/framework": "Auto-discovered service provider BlinkPay\\BlinkDebit\\Laravel\\BlinkDebitServiceProvider",
        "symfony/framework-bundle": "Bundle BlinkPay\\BlinkDebit\\Symfony\\BlinkDebitBundle (Symfony 6.1+)",
        "cakephp/cakephp": "Plugin BlinkPay\\BlinkDebit\\CakePHP\\BlinkDebitPlugin (CakePHP 4.2+)"
    },
    "autoload": {
        "psr-4": {
            "BlinkPay\\BlinkDebit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlinkPay\\BlinkDebit\\Test\\": "test/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlinkPay\\BlinkDebit\\Laravel\\BlinkDebitServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    }
}
